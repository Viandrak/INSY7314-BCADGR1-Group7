  "info": {
    "name": "HustleHub+ Part 2 - Login Rate Limit (standalone)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Standalone: tests the login/register rate limit. Restart the server before running this on its own."
  },
  "item": [
    {
      "name": "Attempt 1 - Login with wrong password",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Attempt 1 returns 401 (wrong password, not yet limited)', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"freelancer1@hustlehub.com\",\"password\":\"WrongPassword1\"}"
        }
